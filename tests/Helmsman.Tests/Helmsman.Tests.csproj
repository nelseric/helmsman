<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <!-- The Unity/BepInEx-free parts of the plugin, compiled in directly. -->
  <ItemGroup>
    <Compile Include="../../src/Helmsman/Core/*.cs" LinkBase="Core" />
    <Compile Include="../../src/Helmsman/Wheel/*.cs" LinkBase="Wheel" />
  </ItemGroup>

</Project>
